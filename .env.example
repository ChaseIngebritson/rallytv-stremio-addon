# Optional local overrides for scripts (not required for Stremio install URL config)
PORT=3000
RALLYTV_LOCALE=en
RALLYTV_COUNTRY=us
# Optional Auth0 access token pasted from a logged-in browser session
RALLYTV_AUTH_TOKEN=
# Absolute base URL returned in stream objects for remux (local default: http://127.0.0.1:$PORT).
# On Railway, RAILWAY_PUBLIC_DOMAIN is used automatically when unset.
# ADDON_BASE_URL=https://your-host.example.com

